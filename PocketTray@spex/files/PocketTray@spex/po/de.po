#: lib/iconMenu.js:65
msgid "Show in panel:"
msgstr "In der Leiste zeigen:"

#: lib/iconMenu.js:65
msgid "No tray icons"
msgstr "Keine Tray-Icons"

#. settings-schema.json->hide-new-icons->description
#: lib/iconMenu.js:74
msgid "Put new icons into the pocket"
msgstr "Neue Icons automatisch in die Tasche legen"

#: lib/rivalGuard.js:60
msgid "PocketTray has been removed from the panel"
msgstr "PocketTray wurde aus der Leiste entfernt"

#: lib/rivalGuard.js:61
#, javascript-format
msgid ""
"PocketTray replaces these applets, which already show tray icons: %s. "
"Running them side by side shows icons twice and can crash Cinnamon. Remove "
"them from the panel first, then add PocketTray again."
msgstr ""
"PocketTray ersetzt diese Applets, die bereits Tray-Icons anzeigen: %s. "
"Laufen sie gleichzeitig, erscheinen Icons doppelt und Cinnamon kann "
"abstürzen. Entferne sie zuerst aus der Leiste und füge PocketTray dann "
"erneut hinzu."

#. metadata.json->name
msgid "PocketTray"
msgstr "PocketTray"

#. metadata.json->description
msgid ""
"System tray with a pocket: tuck away the tray icons you rarely need and keep "
"the panel tidy. Works with legacy and modern (XApp/StatusNotifier) icons."
msgstr ""
"Systembereich mit Tasche: Selten gebrauchte Tray-Icons verschwinden in einer "
"Tasche, die Leiste bleibt aufgeräumt. Funktioniert mit alten und modernen "
"(XApp/StatusNotifier) Icons."

#. settings-schema.json->page-pocket->title
#. settings-schema.json->pocket-icon->options
msgid "Pocket"
msgstr "Tasche"

#. settings-schema.json->page-button->title
msgid "Pocket button"
msgstr "Taschen-Button"

#. settings-schema.json->page-icons->title
msgid "Icons"
msgstr "Icons"

#. settings-schema.json->section-opening->title
msgid "Opening"
msgstr "Öffnen"

#. settings-schema.json->section-appearance->title
msgid "Appearance"
msgstr "Darstellung"

#. settings-schema.json->section-position-icon->title
msgid "Position and icon"
msgstr "Position und Icon"

#. settings-schema.json->section-new-icons->title
msgid "New icons"
msgstr "Neue Icons"

#. settings-schema.json->section-hidden-icons->title
msgid "Hidden icons"
msgstr "Versteckte Icons"

#. settings-schema.json->section-surface->title
msgid "Showing changed icons"
msgstr "Bei Änderung zeigen"

#. settings-schema.json->open-trigger->description
msgid "Open the pocket on"
msgstr "Tasche öffnen per"

#. settings-schema.json->open-trigger->tooltip
msgid ""
"Hover opens the pocket when the mouse rests on the pocket button; click "
"needs a click."
msgstr ""
"Bei „Überfahren“ öffnet sich die Tasche, sobald die Maus auf dem Taschen-"
"Button ruht; bei „Klick“ braucht es einen Klick."

#. settings-schema.json->open-trigger->options
msgid "Click"
msgstr "Klick"

#. settings-schema.json->open-trigger->options
msgid "Hover"
msgstr "Überfahren"

#. settings-schema.json->hover-delay->units
#. settings-schema.json->close-delay->units
msgid "ms"
msgstr "ms"

#. settings-schema.json->hover-delay->description
msgid "Hover delay before opening"
msgstr "Verzögerung vor dem Öffnen"

#. settings-schema.json->close-delay->description
msgid "Delay before closing after the mouse leaves"
msgstr ""
"Verzögerung vor dem Schließen, nachdem die Maus die Tasche verlassen hat"

#. settings-schema.json->pocket-shortcut->description
msgid "Keyboard shortcut to open the pocket"
msgstr "Tastenkürzel zum Öffnen der Tasche"

#. settings-schema.json->pocket-shortcut->tooltip
msgid "Opens or closes the pocket while it holds icons."
msgstr "Öffnet oder schließt die Tasche, solange sie Icons enthält."

#. settings-schema.json->pocket-layout->description
msgid "Pocket layout"
msgstr "Darstellung der Tasche"

#. settings-schema.json->pocket-layout->tooltip
msgid ""
"With names, the pocket shows one row per icon with the application name. "
"With status text, the current tooltip follows the name, so all states can be "
"read at a glance. Legacy X11 icons have no tooltip."
msgstr ""
"Mit Anwendungsname zeigt die Tasche eine Zeile pro Icon mit dem Namen des "
"Programms. Mit Statustext folgt auf den Namen der aktuelle Tooltip, so "
"lassen sich alle Zustände auf einen Blick ablesen. Alte X11-Icons haben "
"keinen Tooltip."

#. settings-schema.json->pocket-layout->options
msgid "Icons only"
msgstr "Nur Icons"

#. settings-schema.json->pocket-layout->options
msgid "Icons and application name"
msgstr "Icons und Anwendungsname"

#. settings-schema.json->pocket-layout->options
msgid "Icons with status text (incl. name)"
msgstr "Icons mit Statustext (inkl. Anwendungsname)"

#. settings-schema.json->pocket-order->description
msgid "Order of the icons in the pocket"
msgstr "Reihenfolge der Icons in der Tasche"

#. settings-schema.json->pocket-order->tooltip
msgid ""
"Alphabetical sorts by application name. List order follows the list of "
"hidden icons on the Icons tab."
msgstr "Alphabetisch sortiert nach dem Namen des Programms. Die Listen-Reihenfolge folgt der Liste versteckter Icons im Reiter „Icons“."

#. settings-schema.json->pocket-order->options
msgid "Order of appearance"
msgstr "Reihenfolge des Erscheinens"

#. settings-schema.json->pocket-order->options
msgid "Alphabetical"
msgstr "Alphabetisch"

#. settings-schema.json->pocket-order->options
msgid "List order"
msgstr "Listen-Reihenfolge"

#. settings-schema.json->pocket-position->description
msgid "Position of the pocket button"
msgstr "Position des Taschen-Buttons"

#. settings-schema.json->pocket-position->tooltip
msgid "On vertical panels, left means above and right means below the icons."
msgstr ""
"Bei senkrechten Leisten bedeutet links oberhalb und rechts unterhalb der "
"Icons."

#. settings-schema.json->pocket-position->options
msgid "Left of the icons"
msgstr "Links der Icons"

#. settings-schema.json->pocket-position->options
msgid "Right of the icons"
msgstr "Rechts der Icons"

#. settings-schema.json->pocket-icon->description
msgid "Icon of the pocket button"
msgstr "Icon des Taschen-Buttons"

#. settings-schema.json->pocket-icon->tooltip
msgid "Arrow and drawer turn towards the side where the pocket opens."
msgstr ""
"Pfeil und Schublade drehen sich zu der Seite, auf der sich die Tasche öffnet."

#. settings-schema.json->pocket-icon->options
msgid "Three triangles"
msgstr "Drei Dreiecke"

#. settings-schema.json->pocket-icon->options
msgid "Arrow from icon theme"
msgstr "Pfeil aus dem Icon-Thema"

#. settings-schema.json->pocket-icon->options
msgid "PocketTray arrow"
msgstr "PocketTray-Pfeil"

#. settings-schema.json->pocket-icon->options
msgid "Drawer"
msgstr "Schublade"

#. settings-schema.json->pocket-icon->options
msgid "Three dots"
msgstr "Drei Punkte"

#. settings-schema.json->pocket-icon->options
msgid "Grid"
msgstr "Raster"

#. settings-schema.json->pocket-icon->options
msgid "Four circles"
msgstr "Vier Kreise"

#. settings-schema.json->pocket-icon->options
msgid "Three triangles (upside down)"
msgstr "Drei Dreiecke (auf dem Kopf)"

#. settings-schema.json->custom-icon->description
msgid "Custom icon"
msgstr "Eigenes Icon"

#. settings-schema.json->custom-icon->tooltip
msgid "An icon name from your theme or an image file. Not rotated."
msgstr ""
"Ein Icon-Name aus deinem Thema oder eine Bilddatei. Wird nicht gedreht."

#. settings-schema.json->hide-new-icons->tooltip
msgid ""
"Icons of applications PocketTray has not seen before go straight into the "
"pocket. Icons it already knows keep their place."
msgstr ""
"Icons von Programmen, die PocketTray noch nicht kennt, landen direkt in der "
"Tasche. Bekannte Icons behalten ihren Platz."

#. settings-schema.json->hidden-apps->description
msgid "Programs to move into the pocket"
msgstr "Programme, die in die Tasche wandern"

#. settings-schema.json->hidden-apps->tooltip
msgid ""
"Easier: right-click PocketTray and switch the icons on or off there. Names "
"are matched case-insensitively: the name of the status icon, the process "
"name for unnamed status icons, or the WM_CLASS of legacy tray icons."
msgstr ""
"Einfacher: Rechtsklick auf PocketTray und die Icons dort ein- oder "
"ausschalten. Namen werden ohne Beachtung der Groß-/Kleinschreibung "
"verglichen: der Name des Status-Icons, bei namenlosen Status-Icons der "
"Prozessname, bei alten Tray-Icons die WM_CLASS."

#. settings-schema.json->hidden-apps->columns->title
msgid "Program or icon name"
msgstr "Programm- oder Icon-Name"

#. settings-schema.json->surface-on-change->description
msgid "Briefly show changed pocket icons in the panel"
msgstr "Geänderte Icons aus der Tasche kurz in der Leiste zeigen"

#. settings-schema.json->surface-on-change->tooltip
msgid ""
"When an application in the pocket changes its icon (for example a new "
"message or a running backup), the icon appears in the panel for a while. "
"Clicking it puts it back. Legacy X11 icons can't report changes."
msgstr ""
"Ändert ein Programm in der Tasche sein Icon (zum Beispiel bei einer neuen "
"Nachricht oder einem laufenden Backup), erscheint das Icon eine Zeit lang in "
"der Leiste. Ein Klick darauf legt es zurück. Alte X11-Icons können keine "
"Änderungen melden."

#. settings-schema.json->surface-duration->units
msgid "s"
msgstr "s"

#. settings-schema.json->surface-duration->description
msgid "How long such an icon stays in the panel"
msgstr "So lange bleibt ein solches Icon in der Leiste"

#. settings-schema.json->surface-duration->tooltip
msgid "Every further change starts this time again."
msgstr "Jede weitere Änderung startet diese Zeit neu."
