{
    "layout": {
        "type": "layout",
        "pages": ["page-pocket", "page-button", "page-icons"],
        "page-pocket": {
            "type": "page",
            "title": "Pocket",
            "sections": ["section-opening", "section-appearance"]
        },
        "page-button": {
            "type": "page",
            "title": "Pocket button",
            "sections": ["section-position-icon"]
        },
        "page-icons": {
            "type": "page",
            "title": "Icons",
            "sections": ["section-new-icons", "section-hidden-icons", "section-surface"]
        },
        "section-opening": {
            "type": "section",
            "title": "Opening",
            "keys": ["open-trigger", "hover-delay", "close-delay", "pocket-shortcut"]
        },
        "section-appearance": {
            "type": "section",
            "title": "Appearance",
            "keys": ["pocket-layout", "pocket-order"]
        },
        "section-position-icon": {
            "type": "section",
            "title": "Position and icon",
            "keys": ["pocket-position", "pocket-icon", "custom-icon"]
        },
        "section-new-icons": {
            "type": "section",
            "title": "New icons",
            "keys": ["hide-new-icons"]
        },
        "section-hidden-icons": {
            "type": "section",
            "title": "Hidden icons",
            "keys": ["hidden-apps"]
        },
        "section-surface": {
            "type": "section",
            "title": "Showing changed icons",
            "keys": ["surface-on-change", "surface-duration"]
        }
    },
    "open-trigger": {
        "type": "combobox",
        "default": "click",
        "description": "Open the pocket on",
        "tooltip": "Hover opens the pocket when the mouse rests on the pocket button; click needs a click.",
        "options": {
            "Click": "click",
            "Hover": "hover"
        }
    },
    "hover-delay": {
        "type": "scale",
        "default": 300,
        "min": 0,
        "max": 1500,
        "step": 50,
        "units": "ms",
        "description": "Hover delay before opening",
        "dependency": "open-trigger=hover"
    },
    "close-delay": {
        "type": "scale",
        "default": 500,
        "min": 50,
        "max": 3000,
        "step": 50,
        "units": "ms",
        "description": "Delay before closing after the mouse leaves",
        "dependency": "open-trigger=hover"
    },
    "pocket-shortcut": {
        "type": "keybinding",
        "default": "",
        "description": "Keyboard shortcut to open the pocket",
        "tooltip": "Opens or closes the pocket while it holds icons."
    },
    "pocket-layout": {
        "type": "combobox",
        "default": "icons",
        "description": "Pocket layout",
        "tooltip": "With names, the pocket shows one row per icon with the application name. With status text, the current tooltip follows the name, so all states can be read at a glance. Legacy X11 icons have no tooltip.",
        "options": {
            "Icons only": "icons",
            "Icons and application name": "names",
            "Icons with status text (incl. name)": "status"
        }
    },
    "pocket-order": {
        "type": "combobox",
        "default": "appearance",
        "description": "Order of the icons in the pocket",
        "tooltip": "Alphabetical sorts by application name. List order follows the list of hidden icons on the Icons tab.",
        "options": {
            "Order of appearance": "appearance",
            "Alphabetical": "name",
            "List order": "list"
        }
    },
    "pocket-position": {
        "type": "combobox",
        "default": "right",
        "description": "Position of the pocket button",
        "tooltip": "On vertical panels, left means above and right means below the icons.",
        "options": {
            "Left of the icons": "left",
            "Right of the icons": "right"
        }
    },
    "pocket-icon": {
        "type": "combobox",
        "default": "triangles",
        "description": "Icon of the pocket button",
        "tooltip": "Arrow and drawer turn towards the side where the pocket opens.",
        "options": {
            "Three triangles": "triangles",
            "Arrow from icon theme": "theme",
            "PocketTray arrow": "arrow",
            "Drawer": "drawer",
            "Pocket": "pocket",
            "Three dots": "dots",
            "Grid": "grid",
            "Four circles": "circles",
            "Three triangles (upside down)": "triangles-down",
            "Custom icon": "custom"
        }
    },
    "custom-icon": {
        "type": "iconfilechooser",
        "default": "",
        "description": "Custom icon",
        "tooltip": "An icon name from your theme or an image file. Not rotated.",
        "dependency": "pocket-icon=custom"
    },
    "hide-new-icons": {
        "type": "switch",
        "default": false,
        "description": "Put new icons into the pocket",
        "tooltip": "Icons of applications PocketTray has not seen before go straight into the pocket. Icons it already knows keep their place."
    },
    "hidden-apps": {
        "type": "list",
        "description": "Programs to move into the pocket",
        "tooltip": "Easier: right-click PocketTray and switch the icons on or off there. Names are matched case-insensitively: the name of the status icon, the process name for unnamed status icons, or the WM_CLASS of legacy tray icons.",
        "columns": [
            {
                "id": "name",
                "title": "Program or icon name",
                "type": "string",
                "default": ""
            }
        ],
        "default": []
    },
    "surface-on-change": {
        "type": "switch",
        "default": false,
        "description": "Briefly show changed pocket icons in the panel",
        "tooltip": "When an application in the pocket changes its icon (for example a new message or a running backup), the icon appears in the panel for a while. Clicking it puts it back. Legacy X11 icons can't report changes."
    },
    "surface-duration": {
        "type": "scale",
        "default": 60,
        "min": 5,
        "max": 900,
        "step": 5,
        "units": "s",
        "description": "How long such an icon stays in the panel",
        "tooltip": "Every further change starts this time again.",
        "dependency": "surface-on-change"
    },
    "known-apps": {
        "type": "generic",
        "default": []
    }
}
